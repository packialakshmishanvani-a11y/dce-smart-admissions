# Server-only secrets. Copy this file to .env.local and fill in real values.
# Never prefix these with NEXT_PUBLIC_ — that would ship them to the browser.

# Google AI Studio key for the Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Make "Custom Webhook" URL for the DCE Unanswered Questions Log scenario
MAKE_WEBHOOK_URL=

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=12000
# MAKE_WEBHOOK_TIMEOUT_MS=4000
# CHAT_RATE_LIMIT_PER_MINUTE=12
